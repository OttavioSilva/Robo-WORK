<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <!--
    NAV_INTEGRADA (10/11/2026): arvore principal. A anterior ficou em
    navigate_to_pose_smooth.xml.bak_navintegrada_<data> (RECUPERACAO_RAPIDA + ARVORE_V3 + MANTER_CAMINHO).

    Planejamento (da candidata, sem perder o que funcionava):
      - consulta a 2 Hz (era 1 Hz);
      - MANTER_CAMINHO: so replaneja com goal novo, caminho com mais de 15 s ou caminho INVALIDO;
        a validade e conferida no TRECHO RESTANTE do caminho executado (TruncatePathLocal), entao um
        obstaculo num pedaco ja percorrido nao forca replanejamento;
      - suavizacao COM checagem de colisao; se ela falhar, usa o caminho original do planner se ele for
        do planner (ORIGINAL_SEM_GATE, 10/11);
      - planner sem caminho: limpa o costmap global uma vez (como antes) e tenta de novo.
    Controle: FollowPath (DWB direto, sem RotationShim: nav2_params.yaml).
    Recuperacao (RECUPERACAO_AVANCADA): o RoundRobin cego foi trocado pelo destravar v4, que diagnostica
      o bloqueio e escolhe UMA manobra segura (devolver ao Nav2 sem mexer / CONTORNAR / lateral com
      continuacao / andar no caminho / giro pelo smart_spin / re so se liberada), confirma pelo LiDAR (ICP)
      ou IMU, nao repete o que nao resolveu no mesmo lugar e FALHA explicitamente quando nao ha
      alternativa. Depois de cada recuperacao o caminho e sempre recalculado e conferido.
      Limpeza de costmaps continua: no planner sem caminho (aqui) e no destravar (BLOQUEIO_LOCAL).
  -->
  <BehaviorTree ID="MainTree">
    <!-- CAMINHO_DO_GOAL (10/11, bag nav_integrada_corredor_aberta): o blackboard sobrevive entre goals;
         sem esta flag, um replanejamento que falhava deixava o FollowPath seguir o caminho do goal
         ANTERIOR e o Nav2 declarava sucesso falso (4 de 5 no bag). Zera no inicio de cada goal e em cada
         tentativa de replanejar; so volta a true com um caminho novo para o goal atual. -->
    <Sequence name="GoalNovo">
    <Script name="CaminhoAindaNao" code="caminho_do_goal := false" />
    <Script name="SemBloqueioAinda" code="caminho_bloqueado := false" />
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector" />
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector" />
        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Fallback name="ManterCaminho">
              <ReactiveSequence name="CaminhoAtualServe">
                <Inverter>
                  <GlobalUpdatedGoal />
                </Inverter>
                <Inverter>
                  <PathExpiringTimer seconds="15" path="{path}" />
                </Inverter>
                <ScriptCondition name="CaminhoEDesteGoal" code="caminho_do_goal" />
                <TruncatePathLocal input_path="{smoothed_path}" output_path="{remaining_path}" distance_forward="1000000.0" distance_backward="0.0" robot_frame="base_link" transform_tolerance="0.3" />
                <IsPathValid path="{remaining_path}" />
              </ReactiveSequence>
              <Sequence name="PlanejarESuavizar">
                <Script name="InvalidarCaminho" code="caminho_do_goal := false" />
                <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}" />
                <!-- ORIGINAL_SEM_GATE (10/11): suavizado que colide -> caminho do planner (feito agora no costmap
                     atual, raio inscrito). O IsPathValid reprovava esses caminhos pelo trecho do goal, que fica
                     na zona inflada perto de mesa/parede, e parava o robo no meio do trajeto. -->
                <!-- CAMINHO_ORIGINAL (11/11): o original so vai ao FollowPath se a condicao CaminhoOriginalSeguro
                     (robo_bt_plugins) nao achar BLOQUEIO no trecho restante: footprint na tangente sobre LETHAL que
                     nenhum deslocamento lateral de ate 10 cm livra (rasante de parede passa). Instalado em
                     modo="registrar" (so log); A/B: publicar "aplicar" no topico /caminho_original/modo (comando
                     em ferramentas/patches/aplicar_caminho_original.py). Reprovado: caminho_bloqueado e recuperacao
                     avaliada. -->
                <Fallback name="SuavizadoOuOriginal">
                  <SmoothPath unsmoothed_path="{path}" smoothed_path="{smoothed_path}" smoother_id="simple_smoother" max_smoothing_duration="2.0" check_for_collisions="true" error_code_id="{smoothing_path_error_code}" />
                  <Sequence name="OriginalConferido">
                    <CaminhoOriginalSeguro name="ConferirOriginal" path="{path}" goal="{goal}" modo="registrar" folga_inicio="0.30" folga_fim="0.60" tolerancia_lateral="0.10" />
                    <SetBlackboard name="UsarOriginalDoPlanner" output_key="smoothed_path" value="{path}" />
                  </Sequence>
                  <Sequence name="OriginalBloqueado">
                    <Script name="MarcarBloqueio" code="caminho_bloqueado := true" />
                    <AlwaysFailure />
                  </Sequence>
                </Fallback>
                <Script name="CaminhoDesteGoal" code="caminho_do_goal := true" />
                <Script name="CaminhoLiberado" code="caminho_bloqueado := false" />
              </Sequence>
            </Fallback>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}" />
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap" />
            </Sequence>
          </RecoveryNode>
        </RateController>
        <!-- GOAL_TF_ATUAL (11/11): o FollowPath recebe o caminho com carimbo zero; o goal checker do
             controller_server passa a usar o map->odom mais recente, igual ao DWB (giro travado 12:37). -->
        <CaminhoSemCarimbo name="CaminhoParaOControlador" input_path="{smoothed_path}" output_path="{caminho_controlador}" />
        <FollowPath path="{caminho_controlador}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}" />
      </PipelineSequence>
      <Sequence name="RecuperacaoAvaliada">
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}" />
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}" />
          <WouldASmootherRecoveryHelp error_code="{smoothing_path_error_code}" />
          <ScriptCondition name="OriginalBloqueadoPedeRecuperacao" code="caminho_bloqueado" />
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated />
          <Sequence name="DestravarEReplanejar">
            <DriveOnHeading server_name="destravar" dist_to_travel="0.40" speed="0.03" time_allowance="30.0" error_code_id="{destravar_code_id}" />
            <Fallback name="CaminhoDepoisDaRecuperacao">
              <Sequence>
                <Script name="InvalidarCaminhoRecuperacao" code="caminho_do_goal := false" />
                <ComputePathToPose name="ReplanAfterRecovery" goal="{goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}" />
                <Fallback>
                  <SmoothPath name="CheckRecoveredPath" unsmoothed_path="{path}" smoothed_path="{smoothed_path}" smoother_id="simple_smoother" max_smoothing_duration="2.0" check_for_collisions="true" error_code_id="{smoothing_path_error_code}" />
                  <Sequence name="OriginalConferidoRecuperacao">
                    <CaminhoOriginalSeguro name="ConferirOriginalRecuperacao" path="{path}" goal="{goal}" modo="registrar" folga_inicio="0.30" folga_fim="0.60" tolerancia_lateral="0.10" />
                    <SetBlackboard output_key="smoothed_path" value="{path}" />
                  </Sequence>
                </Fallback>
                <Script name="CaminhoDesteGoalRecuperacao" code="caminho_do_goal := true" />
              </Sequence>
              <AlwaysSuccess name="PlanejamentoFicaComAPipeline" />
            </Fallback>
          </Sequence>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
