+            return None
+        ns = sec*1_000_000_000+nano
+        if ns > ros_ns or (anterior is not None and ns <= anterior):
+            return None
+        sample = cls(ns, ros_ns, mono, atraso)
+        return sample if sample.recente(ros_ns, mono) else None
