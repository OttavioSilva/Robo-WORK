+        p=ast.literal_eval(self.cm['SweptTurnStop']['left_turn']['points'])
+        def dentro(x,y):
+            return all((p[(i+1)%len(p)][0]-a[0])*(y-a[1])-
+                       (p[(i+1)%len(p)][1]-a[1])*(x-a[0])>=-1e-6 for i,a in enumerate(p))
